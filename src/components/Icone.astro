---
// Icônes en SVG intégré (aucune ressource externe). Noms : globe, consultant, puce, bouclier, nuage, seo, linkedin, instagram, x, facebook.
interface Props { nom: string; taille?: number }
const { nom, taille = 24 } = Astro.props;
---
<svg class="icone" width={taille} height={taille} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {nom === 'globe' && <g fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z"/></g>}
  {nom === 'consultant' && <g fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="7.5" r="3.5"/><path d="M5 20c.6-3.9 3.4-6 7-6s6.4 2.1 7 6"/><path d="M10.5 14l1.5 3 1.5-3"/></g>}
  {nom === 'puce' && <g fill="none" stroke="currentColor" stroke-width="1.6"><rect x="6" y="6" width="12" height="12" rx="1.5"/><rect x="9.5" y="9.5" width="5" height="5"/><path d="M9 3v3M12 3v3M15 3v3M9 18v3M12 18v3M15 18v3M3 9h3M3 12h3M3 15h3M18 9h3M18 12h3M18 15h3"/></g>}
  {nom === 'bouclier' && <g fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3l7 3v5.5c0 4.3-2.9 8-7 9.5-4.1-1.5-7-5.2-7-9.5V6z"/><path d="M8.8 12.2l2.2 2.2 4.3-4.6"/></g>}
  {nom === 'nuage' && <g fill="none" stroke="currentColor" stroke-width="1.6"><path d="M7 18h10a4 4 0 0 0 .6-7.95A5.5 5.5 0 0 0 7.1 9.1 4.5 4.5 0 0 0 7 18z"/><path d="M9.5 13.5l2 2 3.5-3.8"/></g>}
  {nom === 'seo' && <g fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="10.5" cy="10.5" r="6"/><path d="M15 15l5.5 5.5M7.5 12.5v-2M10.5 12.5v-4M13.5 12.5V9.5"/></g>}
  {nom === 'code' && <g fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="4" width="18" height="14" rx="2"/><path d="M9.5 9l-2.5 2.5L9.5 14M14.5 9l2.5 2.5-2.5 2.5M8 21h8"/></g>}
  {nom === 'panier' && <g fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 4h2.5l2.2 10.2a1.5 1.5 0 0 0 1.5 1.2h7.9a1.5 1.5 0 0 0 1.5-1.1L20.5 8H6.4"/><circle cx="10" cy="19.5" r="1.3"/><circle cx="17" cy="19.5" r="1.3"/></g>}
  {nom === 'mobile' && <g fill="none" stroke="currentColor" stroke-width="1.6"><rect x="7" y="2.5" width="10" height="19" rx="2.2"/><path d="M10.5 18.5h3"/></g>}
  {nom === 'graphique' && <g fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 20V4M4 20h16"/><path d="M7.5 15l3.5-4 3 2.5 5-6"/><path d="M16 7.5h3v3"/></g>}
  {nom === 'serveur' && <g fill="none" stroke="currentColor" stroke-width="1.6"><rect x="4" y="3.5" width="16" height="7" rx="1.5"/><rect x="4" y="13.5" width="16" height="7" rx="1.5"/><path d="M7.5 7h.01M7.5 17h.01M11 7h5M11 17h5"/></g>}
  {nom === 'tableau' && <g fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M9 9v11M14.5 12.5h3.5M14.5 16h3.5M5.5 12.5h1M5.5 16h1"/></g>}
  {nom === 'equipe' && <g fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="9" cy="8" r="3"/><circle cx="17" cy="9.5" r="2.3"/><path d="M3.5 19c.5-3.4 2.7-5.3 5.5-5.3s5 1.9 5.5 5.3M14.6 14.4c.7-.4 1.5-.6 2.4-.6 2.1 0 3.7 1.4 4 4.2"/></g>}
  {nom === 'linkedin' && <path fill="currentColor" d="M4.5 3.5a2 2 0 1 1 0 4 2 2 0 0 1 0-4zM3 9h3v12H3zM9 9h2.9v1.7h.04c.4-.76 1.4-1.9 3.4-1.9 3.1 0 3.7 2 3.7 4.7V21h-3v-5.8c0-1.4 0-3.1-1.9-3.1s-2.2 1.5-2.2 3V21H9z"/>}
  {nom === 'instagram' && <g fill="none" stroke="currentColor" stroke-width="2"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="0.6" fill="currentColor"/></g>}
  {nom === 'x' && <path fill="currentColor" d="M17.8 3h3.1l-6.8 7.8L22 21h-6.2l-4.9-6.4L5.3 21H2.2l7.3-8.3L2 3h6.4l4.4 5.8zm-1.1 16.2h1.7L7.4 4.7H5.6z"/>}
  {nom === 'facebook' && <path fill="currentColor" d="M12 2a10 10 0 0 0-1.6 19.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.3v7A10 10 0 0 0 12 2z"/>}
</svg>
